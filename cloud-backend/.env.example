# 复制为 .env 并修改
# JWT 密钥：务必改为随机长字符串（python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=change-me-to-a-random-secret
# JWT 有效期（秒），客户端心跳会刷新会话状态
JWT_EXPIRE_SECONDS=604800
# 服务监听
HOST=0.0.0.0
PORT=8000
# 数据库 URL（MVP 用 SQLite，生产可换 postgresql+psycopg://...）
DATABASE_URL=sqlite:///./cloud.db
# 每用户每日云端模型 token 配额（防刷爆 API Key 账单），按 UTC 日期重置
DAILY_TOKEN_QUOTA=500000
